# Server-only configuration. Copy to .env.local; never commit real values.
# Use Vercel Environment Variables for deployed credentials.
GNANI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# A private workspace code protects the paid speech/extraction routes.
# Generate a long random code and an independent signing secret (at least 32 bytes).
DARA_ACCESS_CODE=
DARA_SESSION_SECRET=
