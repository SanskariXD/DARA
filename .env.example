# DARA is a synthetic demo by default. No key is needed to build or deploy it.
# Copy this file to .env.local; never commit .env.local or actual credentials.
DARA_MODE=demo

# Server-only placeholders. Live adapters are deliberately disabled in this release.
# Adding a key alone does NOT enable real patient workflows; see docs/INTEGRATIONS.md.
GEMINI_API_KEY=
GEMINI_MODEL=
GNANI_API_KEY=
GNANI_STT_WS_URL=
GNANI_TTS_API_URL=
GNANI_TTS_VOICE=

# Future authentication/database adapter (not provisioned).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Future reviewed alert policy. No clinical audio alerts run in the demo.
DARA_CLINICAL_POLICY_VERSION=
